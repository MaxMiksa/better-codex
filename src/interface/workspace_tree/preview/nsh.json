{
  "name": "BetterCodexPreview",
  "id": "dev.bettercodex.workspace-preview",
  "version": "1.0.0",
  "entry": "App.tsx",
  "appearance": "dark",
  "singleInstance": true,
  "fileTypes": [{"name":"Better Codex Preview request","extensions":["bcpreview"]}],
  "window": {
    "title": "Better Codex Preview",
    "titleBar": {"style":"hidden"},
    "defaultVisible": false,
    "defaultSize": {"width":920,"height":620},
    "minSize": {"width":420,"height":280},
    "maxSize": {"width":1280,"height":850},
    "minimizable": false,
    "maximizable": false,
    "taskbar": false,
    "level": "floating"
  },
  "capabilities": {
    "application": true,
    "windows": {"kinds":["normal"],"levels":["normal","floating"],"max":1},
    "fs": {"read":["${dataDir}/requests"],"write":["${dataDir}/requests"]}
  }
}
